# Maintainer: Mark Pustjens <pustjens@dds.nl>

pkgname=hyprtxt
pkgver=1.0.1
pkgrel=1
pkgdesc="Minimal CLI for rendering text with a custom two-row font"
url="https://github.com/unkie/hyprtxt"
license=('MIT')
arch=('x86_64' 'aarch64')
makedepends=('git' 'go')
source=("hyprtxt-src::git+https://github.com/unkie/hyprtxt.git#tag=v$pkgver")

build() {
	cd "$srcdir/hyprtxt-src"
	make GO_BUILD_FLAGS=-trimpath build
}

package() {
	cd "$srcdir/hyprtxt-src"
	make GO_BUILD_FLAGS=-trimpath PREFIX=/usr DESTDIR="$pkgdir" install
}

sha512sums=('SKIP')
